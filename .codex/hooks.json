{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.codex/hooks/engram-brief.sh",
            "statusMessage": "Loading Engram brief"
          }
        ]
      }
    ]
  }
}
